DB_PATH=ads.db
CHECK_INTERVAL_MINUTES=5
DRY_RUN=false

# Backend (.NET API). INTERNAL_API_KEY mora biti isti kao InternalApiKey u backendu.
BACKEND_URL=https://localhost:5001
INTERNAL_API_KEY=
# SAMO za lokalni razvoj (dev sertifikat nije poznat Pythonu) — na serveru mora biti true
BACKEND_VERIFY_TLS=false

KL_SEARCH_URL=
WGG_SEARCH_URL=
IBW_SEARCH_URL=
IBW_EMAIL=
IBW_PASSWORD=
